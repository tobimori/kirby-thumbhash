{
	"name": "tobimori/kirby-thumbhash",
	"description": "Kirby Image placeholders with the smarter ThumbHash integration",
	"type": "kirby-plugin",
	"version": "2.1.1",
	"license": "MIT",
	"homepage": "https://github.com/tobimori/kirby-thumbhash#readme",
	"authors": [
		{
			"name": "Tobias Möritz",
			"email": "tobias@moeritz.io"
		}
	],
	"autoload": {
		"psr-4": {
			"tobimori\\": "classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"tobimori\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.3.0",
		"getkirby/composer-installer": "^1.2",
		"ext-gd": "*"
	},
	"suggest": {
		"ext-imagick": "Faster sampling of large JPEG files"
	},
	"require-dev": {
		"carthage-software/mago": "^1.59.0",
		"getkirby/cms": "^5.6.1",
		"phpunit/phpunit": "^12.0"
	},
	"scripts": {
		"analyze": "mago analyze",
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": [
			"mago lint --fix",
			"mago fmt"
		],
		"fmt": "mago fmt",
		"fmt:check": "mago fmt --check",
		"lint": "mago lint",
		"test": "phpunit"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"carthage-software/mago": true,
			"getkirby/composer-installer": true
		}
	},
	"extra": {
		"kirby-cms-path": false
	}
}
